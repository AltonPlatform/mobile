# Appodeal / Stack: spec repos (git). Order: private specs first so Appodeal resolves from git, not only trunk.
# CDN trunk (jsdelivr) can fail with "HTTP2 framing layer" during `pod install --repo-update` — avoid blanket
# `--repo-update`. Use: `bundle exec pod install` (default does not refresh all spec repos).
# If you only need newer Appodeal/Bidon specs: `pod repo update appodeal-cocoapods bidon-io-cocoapods-specs`
source 'https://github.com/appodeal/CocoaPods.git'
source 'https://github.com/bidon-io/CocoaPods-Specs.git'
source 'https://cdn.cocoapods.org/'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AltonMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AltonMobileTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Swift static pods: даём линкеру искать runtime/compatibility в toolchain (без -weak-l*, на CI часто
    # «Library swiftCompatibility… not found»). Удаляем возможные старые weak-l флаги с прошлых pod install.
    app_project_path = File.expand_path('AltonMobile.xcodeproj', __dir__)
    if File.directory?(app_project_path)
      xcodeproj = Xcodeproj::Project.open(app_project_path)
      swift_paths = [
        '"$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"',
        '"$(SDKROOT)/usr/lib/swift"'
      ]
      xcodeproj.targets.each do |native_target|
        next unless native_target.name == 'AltonMobile'

        native_target.build_configurations.each do |bc|
          paths = bc.build_settings['LIBRARY_SEARCH_PATHS']
          paths = paths.is_a?(Array) ? paths : [paths].compact
          paths.unshift('$(inherited)') unless paths.include?('$(inherited)')
          swift_paths.each do |p|
            paths << p unless paths.include?(p)
          end
          bc.build_settings['LIBRARY_SEARCH_PATHS'] = paths.uniq

          flags = bc.build_settings['OTHER_LDFLAGS']
          flags = flags.is_a?(Array) ? flags : [flags].compact
          flags.reject! { |f| f.to_s.include?('swiftCompatibility') }
          bc.build_settings['OTHER_LDFLAGS'] = flags
        end
      end
      xcodeproj.save
    end
  end
end
